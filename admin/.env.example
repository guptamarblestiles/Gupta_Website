# Copy to .env.local (local dev) or set in the admin Vercel project.
# Names only — never commit real values.

# Same Supabase project as the public site (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe in the browser: every admin permission is
# enforced by RLS against the signed-in user's own session.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for exactly one thing: creating staff logins from
# Team & Permissions (Supabase's auth.admin API). Never exposed to the browser.
SUPABASE_SECRET_KEY=

# This admin app's own public URL, e.g. https://admin.guptainterior.in —
# used in password-reset email links. Must also be listed under Supabase >
# Authentication > URL Configuration > Redirect URLs.
NEXT_PUBLIC_ADMIN_URL=

# The public website, e.g. https://www.guptainterior.in — used for "View on
# website" links and for refreshing its cached pages after a change.
PUBLIC_SITE_URL=
# Shared secret; must equal REVALIDATE_SECRET on the public site's Vercel
# project. Long random string (e.g. `openssl rand -hex 32`).
PUBLIC_REVALIDATE_SECRET=

# Upload limit in MB for PDFs. Supabase's free plan caps a single file at 50.
NEXT_PUBLIC_MAX_PDF_MB=50
