# Copy to .env.local and fill in real values. Placeholders only here — never
# commit real keys. Set the same names in Vercel for Production AND Preview.

# --- Supabase (Project Settings > API Keys) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public, safe in the browser; access is limited by RLS. The code reads ONLY
# this name. The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is only accepted as a
# fallback alias; prefer the PUBLISHABLE name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Never expose to the client or commit. Bypasses RLS.
SUPABASE_SECRET_KEY=your-secret-key

# --- Site / admin URLs -----------------------------------------------------
# Canonical public URL (sitemap, robots, metadata, JSON-LD, password-reset
# fallback). Unset in production falls back to https://www.guptainterior.in
# with a warning; unset in dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.guptainterior.in
# Origin used in admin password-reset links (e.g. https://www.guptainterior.in).
# If unset, NEXT_PUBLIC_SITE_URL is used in production.
NEXT_PUBLIC_ADMIN_URL=https://www.guptainterior.in
# Optional: max PDF upload size in MB for the admin panel (default 50).
# NEXT_PUBLIC_MAX_PDF_MB=50

# --- Enquiry email notifications (lib/enquiry/email.ts) --------------------
# Gmail SMTP: GMAIL_USER is both sender and recipient. GMAIL_APP_PASSWORD is a
# 16-character Google App Password (needs 2FA) — NOT the account password.
# If unset, enquiries still save to Supabase; only the email is skipped.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# --- EmailJS (optional, OFF by default) ------------------------------------
# Browser-side duplicate notification (lib/enquiry/emailjs.ts). The Gmail route
# above is the primary mechanism, so leave this disabled unless you really want
# a second email. Runs only when ENABLED is exactly "true" and all three IDs
# are set.
# NEXT_PUBLIC_EMAILJS_ENABLED=true
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
