# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings > API Keys). Until these are set, the
# app falls back to lib/products/mockProducts.ts and the enquiry form
# reports "not configured" instead of submitting — see
# lib/products/queries.ts, lib/supabase/server.ts, and lib/enquiry/actions.ts.

NEXT_PUBLIC_SUPABASE_URL=
# Public, safe to expose client-side — respects RLS (read-only for the
# catalogue, insert-only for enquiries).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never exposed to the client or committed. Used only where
# the app genuinely needs to bypass RLS.
SUPABASE_SECRET_KEY=

# Admin panel (/admin) — legacy fallback only. The real credential lives in
# the admin_auth table (bcrypt hash), seeded once via
# `npx tsx scripts/admin/seedAdminAuth.ts` (initial password @Gupta123) and
# changed thereafter from /admin/settings. This env var is only consulted
# if no admin_auth row exists yet (see lib/admin/session.ts).
ADMIN_PASSWORD=
# HMAC secret used to sign the admin session cookie so it can't be forged
# by hand-crafting a cookie value. Unrelated to ADMIN_PASSWORD; rotate it to
# invalidate all existing admin sessions at once.
ADMIN_SESSION_SECRET=

# Enquiry email notifications (lib/enquiry/email.ts) — sent via Gmail SMTP
# whenever the contact form is submitted. GMAIL_USER is the Gmail address
# emails are sent from/to; GMAIL_APP_PASSWORD is a 16-character Google App
# Password generated from that account's Google Account > Security > App
# Passwords (requires 2FA enabled) — NOT the account's login password. Until
# both are set, enquiries still save to Supabase; only the email is skipped.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# EmailJS (lib/enquiry/emailjs.ts) — sends the enquiry email directly from
# the visitor's browser to Gupta's inbox, no Gmail App Password needed.
# Get these from emailjs.com after connecting guptamarblestiles@gmail.com
# as an Email Service and creating a Template: Service ID, Template ID,
# and the account's Public Key (Account > General). All three are
# NEXT_PUBLIC_ because EmailJS runs client-side.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Canonical site URL — used for the sitemap, robots.txt, and resolving
# absolute social share image URLs (app/sitemap.ts, app/robots.ts,
# app/layout.tsx's metadataBase). Set to the real Vercel/custom domain
# once deployed; defaults to http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=
