# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings > API) once the project is created.
# Until these are set, the site runs entirely on lib/products/mockProducts.ts
# and the enquiry form reports "not configured" instead of submitting —
# see lib/supabase/server.ts and lib/enquiry/actions.ts.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
